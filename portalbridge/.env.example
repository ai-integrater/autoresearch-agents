# Copy to .env.development / .env.test / .env.production and fill in.
# Each environment should point to its OWN Entra app registration.
# Never share an app reg across environments — it mixes consent grants
# and complicates rotation.

# ---- Public (shipped to the browser) ----
NEXT_PUBLIC_AZURE_CLIENT_ID=
NEXT_PUBLIC_AZURE_TENANT_ID=
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000

# ---- Server-only (BFF / on-behalf-of flow) ----
# Used by /api/graph/* routes when the SPA delegates server-side Graph calls.
AZURE_CLIENT_SECRET=
# Optional: set to "true" to enable verbose MSAL logging in dev.
MSAL_VERBOSE=false
